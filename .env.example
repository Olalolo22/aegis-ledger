# ══════════════════════════════════════════════════════
# Aegis Ledger — Environment Variables
# Copy this file to .env.local and populate with real values.
# ══════════════════════════════════════════════════════

# ── Solana / MagicBlock TEE (NON-CUSTODIAL — no private keys on server) ──
# Main Solana RPC endpoint
SOLANA_RPC_URL=https://api.devnet.solana.com
# Client-side RPC endpoint (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Private Ephemeral Rollup (devnet-tee RPC and validator pubkey)
NEXT_PUBLIC_ER_RPC=https://devnet-tee.magicblock.app
NEXT_PUBLIC_TEE_VALIDATOR=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo

# ── Feature Flags ───────────────────────────────────
# In demo mode, provides verified enclave sandbox fallbacks if wallet has 0 devnet gas.
DEMO_MODE=true

# ── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never exposed to client bundles
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstash Redis ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cryptography ────────────────────────────────────
# 64-char hex string (32 bytes). HKDF root for all viewing-key encryption.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ This is the ONLY location for the master key. NEVER store it in the database.
AEGIS_MASTER_SECRET=
